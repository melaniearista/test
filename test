// LINE CHARTS
function drawLine(id,data,key,color,yMin,yMax){
  const svg=document.getElementById(id);if(!svg)return;
  const W=400,H=150,pad={t:8,r:12,b:28,l:32};
  const iW=W-pad.l-pad.r,iH=H-pad.t-pad.b;
  const vals=data.map(d=>d[key]);
  const lo=yMin!==undefined?yMin:Math.min(...vals)*0.9;
  const hi=yMax!==undefined?yMax:Math.max(...vals)*1.1;
  const px=(_,i)=>pad.l+i*(iW/(data.length-1));
  const py=v=>pad.t+iH-(v-lo)/(hi-lo)*iH;
  let g='';
  [0,.5,1].forEach(f=>{const y=pad.t+iH*(1-f);const v=(lo+(hi-lo)*f).toFixed(1);g+=`<line x1="${pad.l}" y1="${y}" x2="${W-pad.r}" y2="${y}" stroke="#e5e7eb" stroke-width="1"/>`;g+=`<text x="${pad.l-4}" y="${y+4}" text-anchor="end" font-size="9" fill="#9ca3af">${v}</text>`;});
  data.forEach((d,i)=>{g+=`<text x="${px(0,i)}" y="${H-4}" text-anchor="middle" font-size="9" fill="#9ca3af">${d.label||d.month||d.sprint}</text>`;});
  const pts=data.map((d,i)=>`${px(0,i)},${py(d[key])}`).join(' ');
  g+=`<polyline points="${pts}" fill="none" stroke="${color}" stroke-width="2.5" stroke-linejoin="round" stroke-linecap="round"/>`;
  data.forEach((d,i)=>{g+=`<circle cx="${px(0,i)}" cy="${py(d[key])}" r="4" fill="${color}" stroke="white" stroke-width="1.5"/>`;});
  svg.innerHTML=g;
}

