drawLine('lc-incidents',[{month:'Oct',v:12},{month:'Nov',v:8},{month:'Dec',v:10},{month:'Jan',v:6},{month:'Feb',v:5},{month:'Mar',v:4}],'v','#a855f7');
drawLine('lc-month',[{month:'Oct',v:45},{month:'Nov',v:38},{month:'Dec',v:42},{month:'Jan',v:35},{month:'Feb',v:28},{month:'Mar',v:24}],'v','#9333ea');
drawLine('lc-sprint',[{sprint:'S1',v:8},{sprint:'S2',v:12},{sprint:'S3',v:9},{sprint:'S4',v:11},{sprint:'S5',v:7},{sprint:'S6',v:6}],'v','#a855f7');

// DIMENSION VALUES per signal
const dimData={
  pos:[
    {label:'Completeness', value:'93.10%', variant:'w'},
    {label:'Consistency',  value:'91.33%', variant:'w'},
    {label:'Timeliness',   value:'88.75%', variant:'w'},
  ],
  rtdx:[
    {label:'Distributor Performance', value:'95.20%', variant:'s'},
    {label:'Validity',                value:'89.60%', variant:'w'},
    {label:'Completeness',            value:'91.80%', variant:'w'},
  ],
};
const varColor={d:'var(--gray-800)',s:'var(--green)',w:'var(--yellow)'};
function renderDims(sig){
  const rows=document.getElementById('dim-rows');
  if(!rows) return;
  const dims=dimData[sig]||dimData.pos;
  rows.innerHTML=dims.map(d=>`
    <div style="flex:1;background:var(--gray-50);border:1px solid var(--gray-200);border-radius:6px;padding:4px 8px;display:flex;align-items:center;justify-content:space-between;gap:4px;min-height:0">
      <span style="font-size:10px;color:var(--gray-500);white-space:nowrap;overflow:hidden;text-overflow:ellipsis;flex:1">${d.label}</span>
      <span style="font-size:13px;font-weight:700;color:${varColor[d.variant]};white-space:nowrap;flex-shrink:0">${d.value}</span>
    </div>
  `).join('');
}
renderDims('pos');

// INCIDENT MODAL
function openIncident(pipeline){
  const overlay=document.createElement('div');
  overlay.className='modal-overlay';
  overlay.innerHTML=`
    <div class="modal-box">
      <div class="modal-title">Reportar Incidente</div>
      <div class="modal-sub">Pipeline: <strong>${pipeline}</strong> · ServiceNow</div>
      <div class="modal-field">
        <div class="modal-label">Título del Incidente</div>
        <input class="modal-input" placeholder="Ej. Missing data since April 15th…"/>
      </div>
      <div class="modal-field">
        <div class="modal-label">Prioridad</div>
        <select class="modal-select">
          <option>1 – Critical</option>
          <option>2 – High</option>
          <option selected>3 – Medium</option>
          <option>4 – Low</option>
        </select>
      </div>
      <div class="modal-field">
        <div class="modal-label">Descripción</div>
        <textarea class="modal-textarea" placeholder="Describe el problema, impacto y pasos para reproducirlo…"></textarea>
      </div>
      <div class="modal-footer">
        <button class="modal-cancel" onclick="this.closest('.modal-overlay').remove()">Cancelar</button>
        <button class="modal-submit" onclick="submitIncident(this,'${pipeline}')">Crear Incidente</button>
      </div>
    </div>`;
  document.body.appendChild(overlay);
  overlay.addEventListener('click',e=>{ if(e.target===overlay) overlay.remove(); });
}
function submitIncident(btn, pipeline){
  btn.textContent='Enviando…';
  btn.disabled=true;
  setTimeout(()=>{
    btn.closest('.modal-overlay').remove();
    const toast=document.createElement('div');
    toast.style.cssText='position:fixed;bottom:24px;right:24px;background:#1f2937;color:#fff;padding:12px 20px;border-radius:10px;font-size:13px;font-weight:500;box-shadow:0 8px 24px rgba(0,0,0,.25);z-index:9999;display:flex;align-items:center;gap:10px;animation:slideUp .2s ease';
    toast.innerHTML=`<svg width="16" height="16" fill="none" stroke="#4ade80" stroke-width="2.5" viewBox="0 0 24 24"><path d="M22 11.08V12a10 10 0 11-5.93-9.14"/><polyline points="22 4 12 14.01 9 11.01"/></svg> Incidente creado en <strong>${pipeline}</strong>`;
    document.body.appendChild(toast);
    setTimeout(()=>toast.remove(),3500);
  },900);
}

// NAVIGATION
function switchSignal(sig){
  document.querySelectorAll('.stab').forEach(t=>t.classList.remove('active'));
  document.getElementById('stab-'+sig).classList.add('active');
  const isMedia=sig==='media';
  const isOverview=sig==='overview';
  document.getElementById('subnav-pos').style.display=(!isMedia&&!isOverview)?'flex':'none';
  document.getElementById('subnav-media').style.display=isMedia?'flex':'none';
  if(!isMedia&&!isOverview) {
    renderDims(sig);
    // update the report button label in the subnav
    const btn = document.querySelector('#subnav-pos button');
    if(btn) btn.onclick = () => openIncident(sig.toUpperCase());
  }
  hideAll();
  if(isOverview){
    document.getElementById('page-overview').classList.add('active');
  } else if(isMedia){
    document.getElementById('page-vendor').classList.add('active');
    document.querySelectorAll('#subnav-media .snav').forEach((e,i)=>{e.className='snav'+(i===0?' activep':'');});
  } else {
    document.getElementById('page-kpis').classList.add('active');
    document.querySelectorAll('#subnav-pos .snav').forEach((e,i)=>{e.className='snav'+(i===0?' active':'');});
  }
}
// Start on Overview
switchSignal('overview');
function hideAll(){document.querySelectorAll('.page').forEach(p=>p.classList.remove('active'));}
function switchPage(el,id,signal){
  if(signal==='media'){document.querySelectorAll('#subnav-media .snav').forEach(e=>e.className='snav');el.className='snav activep';}
  else{document.querySelectorAll('#subnav-pos .snav').forEach(e=>e.className='snav');el.className='snav active';}
  hideAll();document.getElementById('page-'+id).classList.add('active');
}
</script>
